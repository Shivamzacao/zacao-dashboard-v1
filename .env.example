# Server-only configuration. Never put real values in this file — copy it to
# .env.local (gitignored) and fill the secrets there.

REPORTING_TIMEZONE=America/New_York
REPORTING_CURRENCY=USD

# Frontend data mode: "live" serves certified backend data, "fixture" serves the
# Phase 2 synthetic contract used by tests and visual baselines.
ZACAO_DATA_MODE=fixture

# Shopify — Dev Dashboard app credentials. The server exchanges these for
# short-lived Admin API tokens (client-credentials grant); no static token is
# stored. Requires the read-only scopes documented in the architecture plan.
SHOPIFY_SHOP_DOMAIN=example-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07

# Klaviyo — read-only private API key.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_API_REVISION=2026-07-15
KLAVIYO_CONVERSION_METRIC_ID=
# Optional Customer Intelligence demographics. Configure both custom-property
# names together and grant the private API key profiles:read.
KLAVIYO_AGE_BAND_PROPERTY=
KLAVIYO_GENDER_PROPERTY=

# Direct, server-only Google Sheets dashboard source.
GOOGLE_SHEETS_DASHBOARD_WORKBOOK_ID=1vOkSXadR0WAFmUgWUvZmxmOoxVs5fxYkIW3GT2FmjjA
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Paste the service-account private key as a deployment secret. Escaped
# newlines (\n) are normalized by the server-only configuration loader.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_REQUEST_TIMEOUT_MS=30000
GOOGLE_SHEETS_ROW_CHUNK_SIZE=1000
