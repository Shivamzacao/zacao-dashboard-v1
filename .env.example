# Server-only configuration. Never put real values in this file — copy it to
# .env.local (gitignored) and fill the secrets there.

REPORTING_TIMEZONE=America/New_York
REPORTING_CURRENCY=USD

# Frontend data mode: "live" serves certified backend data, "fixture" serves the
# Phase 2 synthetic contract used by tests and visual baselines.
ZACAO_DATA_MODE=fixture

# Shopify — Dev Dashboard app credentials. The server exchanges these for
# short-lived Admin API tokens (client-credentials grant); no static token is
# stored. Requires the read-only scopes documented in the architecture plan.
SHOPIFY_SHOP_DOMAIN=example-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07

# Klaviyo — read-only private API key.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_API_REVISION=2026-07-15
KLAVIYO_CONVERSION_METRIC_ID=

# Google Sheets dashboard APIs. Page URLs are used first so each dashboard
# fetches only its required tabs. The aggregate URL is compatibility fallback.
ZACAO_SHEETS_AGGREGATE_API_URL=https://flow.sokt.io/func/scriv6LXUyiH
# Optional JSON map overriding the built-in page endpoints.
ZACAO_SHEETS_PAGE_API_URLS={"insights":"https://flow.sokt.io/func/scrizXhpyoZL","product":"https://flow.sokt.io/func/scriFSpXBNz4","finance":"https://flow.sokt.io/func/scriCETwQ0tC","marketing":"https://flow.sokt.io/func/scri6MeUHDNH","growth":"https://flow.sokt.io/func/scrijcFi21hy","operations":"https://flow.sokt.io/func/scriRlQcbgmk"}
# Optional JSON object of tab-specific HTTPS URLs. Configured tabs take
# precedence over both page and aggregate endpoints.
ZACAO_SHEETS_TAB_API_URLS={}
ZACAO_SHEETS_API_TIMEOUT_MS=30000

# Manual workbook store (Supabase Postgres, ADR-003 / DEC-017).
# DATABASE_URL: transaction pooler URI (port 6543) used at runtime.
# DATABASE_MIGRATE_URL: session connection (port 5432) used by `pnpm db:migrate`;
#   falls back to DATABASE_URL when unset. DDL through the pooler is unreliable.
# Leave both unset to run without the store: validation still works, saving is
# refused, and manual_workbook reports not_configured.
DATABASE_URL=
DATABASE_MIGRATE_URL=
